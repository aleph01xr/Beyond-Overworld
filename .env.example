# Optional PostgreSQL connection string for Overworld-only tables
# When unset, Beyond: Overworld uses its graceful in-memory fallback store.
DATABASE_URL=

# Set to "production" to enforce Beyond: Dungeons as the authoritative identity provider
# and disable Dev Login + local registration/login fallbacks.
NODE_ENV=development

# Server port (must remain 3000 inside AI Studio runtime)
PORT=3000

# Backend-only Beyond: Dungeons Shared Identity Integration
# Required in production; never expose BEYOND_IDENTITY_SECRET or DUNGEONS_API_URL to clients.
DUNGEONS_API_URL=
BEYOND_IDENTITY_SECRET=
