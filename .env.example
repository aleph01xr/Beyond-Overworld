# Optional PostgreSQL connection string for Overworld-only tables
# When unset, Beyond: Overworld uses its graceful in-memory fallback store.
DATABASE_URL=

# Server port (must remain 3000 inside AI Studio runtime)
PORT=3000

# Backend-only Beyond: Dungeons Shared Identity Integration (Phase 1 Preparation)
# Leave unset to retain local development authentication. Never expose BEYOND_IDENTITY_SECRET to clients.
DUNGEONS_API_URL=
BEYOND_IDENTITY_SECRET=
